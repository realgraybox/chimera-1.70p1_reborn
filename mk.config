# mk.config – updated
#
# TOP is the path from the including Makefile to this directory, as
# written in its "include" line ("./", "../" or "../../"). It is kept
# relative on purpose: make cannot handle spaces in target names, so an
# absolute path breaks the build in a directory like "Linux ext2".
TOP := $(dir $(lastword $(MAKEFILE_LIST)))

CC         = gcc
AR         = ar

# Installation paths
PREFIX     ?= /usr
BINDIR     ?= $(PREFIX)/bin
USERDATADIR = $$HOME/chimera

# Preprocessor flags
CPPFLAGS  = \
	-DCUTILDIR=\"$(BINDIR)\" \
	-DCONVERT_FILES=\"$(USERDATADIR)/convert\" \
	-DMIME_TYPE_FILES=\"$(USERDATADIR)/mime.types\" \
	-DMAIL_CAPS=\"$(USERDATADIR)/mailcap\" \
	-DPROTOCOL_FILES=\"$(USERDATADIR)/protocol\" \
	-DCACHE_INFO_FILES=\"$(USERDATADIR)/cacheinfo\" \
	-DHELP_URL=\"file:$(USERDATADIR)/help.html\" \
	-DHOME_URL=\"file:$(USERDATADIR)/home.html\" \
	-D_GNU_SOURCE -DX_LOCALE \
	-DFUNCPROTO=15 -DNARROWPROTO -DXRELEASE=604 \
	-DHAVE_STDLIB_H -DHAVE_STRING_H -DHAVE_UNISTD_H -DHAVE_MALLOC_H \
	-I../ -I../mxw -I../common -I../libhtmlw -I../xloadimage \
	-I/usr/X11R6/include
	
XAW_LIB_TYPE = XAWPLUS
	
ifeq ($(XAW_LIB_TYPE), XAWPLUS)
    XAW_LIBS = $(TOP)XawPlus-2.0.2/libXawPlus.a
    # xaw-compat/X11/Xaw points at XawPlus's headers, so code that includes
    # <X11/Xaw/...> (libhtmlw, mxw) is compiled against the widget set it
    # is linked with, and libxaw's headers are not needed
    XAW_DEFS = -DUSE_XAWPLUS -I$(TOP)XawPlus-2.0.2/xaw-compat -I$(TOP)XawPlus-2.0.2
else ifeq ($(XAW_LIB_TYPE), XAW3D)
    XAW_LIBS = -lXaw3d
    XAW_DEFS = -DUSE_XAW3D
else
    XAW_LIBS = -lXaw
    XAW_DEFS = -DUSE_XAW
endif

PROJ_LIBS = -L$(TOP)mxw -lmxw \
            -L$(TOP)libhtmlw -lhtmlw \
            -L$(TOP)xloadimage -lxloadimage
            
SYS_LIBS = $(XAW_LIBS) -lXmu -lXt -lSM -lICE -lXpm -lXext -lX11 -lm

# Compiler flags
#-Os -Wall $(STATIC) -ffunction-sections -fdata-sections -march=i386
#-O0 -g -pg
#-DGPROFOPT


CFLAGS    = -Os -Wall $(STATIC) $(XAW_DEFS) -ffunction-sections -fdata-sections \
		-DIMAGENEW -DREBOUNCH -DGPROFOPT

# Target detection, so switching between the 64-bit glibc and the 32-bit
# uClibc toolchain needs no edits here: make CC=<compiler> is enough.
# Must stay below CFLAGS, since it adds to it.
TARGET_MACHINE := $(shell $(CC) -dumpmachine)
TARGET_CPU     := $(firstword $(subst -, ,$(TARGET_MACHINE)))
IS_UCLIBC      := $(shell $(CC) -include features.h -dM -E - </dev/null 2>/dev/null | grep -c __UCLIBC__)

ifeq ($(TARGET_CPU),x86_64)
    ELF_FORMAT = elf64-x86-64
    ELF_ARCH   = i386:x86-64
else ifneq ($(filter i386 i486 i586 i686,$(TARGET_CPU)),)
    ELF_FORMAT = elf32-i386
    ELF_ARCH   = i386
endif

# uClibc: link statically. Old uClibc lacks sinf(), powf() and friends, so
# src/inline.c supplies them as wrappers around sin(), pow() and so on; the
# -fno-builtin flags stop gcc from compiling those wrappers back into calls
# to themselves.
ifeq ($(IS_UCLIBC),1)
    STATIC  = -static
    CFLAGS += -D__UCLIBC__ -fno-builtin-sin -fno-builtin-cos -fno-builtin-tan \
              -fno-builtin-atan2 -fno-builtin-fmod -fno-builtin-acos \
              -fno-builtin-pow -fno-builtin-exp
endif

# Linker flags: 
#$(STATIC) -Wl,--gc-sections,--sort-common,-s

# Link flags for the helper programs and the libraries they build with
# ./configure: no Chimera libraries, which configure's test programs
# would not find from inside the library's own directory
HELPER_LDFLAGS = $(STATIC) -Wl,--gc-sections,--sort-common,-s

LDFLAGS   =  $(STATIC) -Wl,--gc-sections,--sort-common,-s \
	$(PROJ_LIBS) \
	$(SYS_LIBS)
	

