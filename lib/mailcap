#
# mailcap - external programs for content Chimera does not show itself
#
# Format: content-type; command
#
# The command is everything after the first ';' up to the next ';' or
# the end of the line, so it cannot contain a further ';'. %s is
# replaced by the downloaded file, and may appear only once. Chimera
# deletes that file as soon as the command returns.
#
# chimera-open copies the file and hands the copy to the desktop's
# default program (xdg-open), so it works with programs that return at
# once. Without xdg-open it falls back to xvl for images. FITS images
# are converted to GIF first.
#
# The first matching line wins, so specific types go before wildcards.
#

application/x-telnet;	xterm -e sh -c "dotelnet %s"
application/x-tn3270;	xterm -e sh -c "do3270 %s"

image/*;		chimera-open %s
video/*;		chimera-open %s
audio/*;		chimera-open %s

application/postscript;	chimera-open %s
application/pdf;	chimera-open %s

# anything else, for example office documents and archives
application/*;		chimera-open %s
