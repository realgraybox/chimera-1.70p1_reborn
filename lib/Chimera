! Chimera X resources: dark theme (the default)
!
! "make install" installs this file as ~/Chimera, where Xt finds it, and
! the light theme as ~/Chimera-light. To use the light theme:
!
!   chimera -xrm '*customization: -light'     for one session
!   cp ~/Chimera-light ~/Chimera               to make it the default
!
! Xt reads ~/Chimera-light instead of ~/Chimera when the customization
! is set, so each theme file is complete. Colours are near the top; edit
! them and restart Chimera, no rebuild needed.

Chimera.convertFiles: ~/chimera/convert
Chimera.protocolFiles: ~/chimera/protocol
Chimera.mailCapFiles: ~/chimera/mailcap
Chimera.mimeTypeFiles: ~/chimera/mime.types
Chimera.bookmarkFile: ~/chimera/bookmarks

! A directory shows its file list, even when it has an index.html. Give
! file names here, separated by colons (index.html:index.htm), to open
! the first one found instead.
Chimera.localIndexFiles:

Chimera.maxColors:	1024

Chimera.cacheOff:                 True
Chimera.cacheDir:                 ~/chimera/cache
Chimera.cacheTTL:                 14400
Chimera.cacheSize:                4000000
Chimera.cacheClean:               True

! Ask before a downloaded file (a PDF, a video, ...) is handed to a
! program from the mailcap file. False opens it straight away, as
! Chimera used to: then any page can start those programs.
Chimera.confirmExternal:          True
Chimera.cacheIgnoreExpires:       False

! Fallbacks for the resources below are in src/fallback.c:
Chimera*showGrip:                  False
! ---- Colours (dark theme) ----------------------------------
! Window, buttons and menus
Chimera*background:		#2e2e2e
Chimera*foreground:		#dcdcdc
Chimera*borderColor:		#5a5a5a

! 3D edges. XawPlus: highlightColor/shadowColor, buttonBorderWidth.
! Xaw3d: topShadowPixel/bottomShadowPixel. Plain Xaw has no 3D edges.
Chimera*highlightColor:		#4a4a4a
Chimera*shadowColor:		#161616
Chimera*buttonBorderWidth:	1
Chimera*beNiceToColormap:	False
Chimera*topShadowPixel:		#4a4a4a
Chimera*bottomShadowPixel:	#161616

! Scrollbars
Chimera*Scrollbar.background:	#262626
Chimera*Scrollbar.foreground:	#5a5a5a
Chimera*html*Vbar.background:	#262626
Chimera*html*Hbar.background:	#262626

! Text fields: URL, title, dialogs
Chimera*Text*background:	#141414
Chimera*Text*foreground:	#eeeeee

! Page area. Pages that set their own colours (<body bgcolor=...>)
! still use them; set useBodyColors to False below to ignore them.
Chimera*html*background:	#1e1e1e
Chimera*html*foreground:	#dcdcdc
Chimera*html.anchorColor:		#8ab4f8
Chimera*html.visitedAnchorColor:	#c58af9
